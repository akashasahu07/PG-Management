# Neon PostgreSQL Database Connections
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret (32+ character random string)
AUTH_SECRET="your_jwt_secret_key_here"

# App Defaults
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="your_admin_password"
NEXT_PUBLIC_APP_NAME="Elite Homes"
